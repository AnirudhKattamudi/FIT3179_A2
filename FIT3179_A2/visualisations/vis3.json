
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Has the Mix of Nature Photography Changed?",
    "subtitle": "Share of selected ALA photographic records by nature group, 2023–2025",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 12,
    "offset": 20
  },
  "width": 650,
  "height": 340,
  "data": {
    "url": "data/02_ala_annual_counts.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "population_count": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "population_count",
          "as": "records"
        }
      ],
      "groupby": ["year", "category"]
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "records",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of photographic records",
      "axis": {
        "format": ".0%"
      }
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Nature group",
      "scale": {
        "domain": [
          "Plants",
          "Insects",
          "Birds",
          "Fungi",
          "Mammals",
          "Reptiles",
          "Amphibians"
        ],
        "range": [
          "#24765B",
          "#E6A23C",
          "#4C78A8",
          "#9467BD",
          "#E07B75",
          "#72B7B2",
          "#B5CF6B"
        ]
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "category",
        "type": "nominal",
        "title": "Nature group"
      },
      {
        "field": "records",
        "type": "quantitative",
        "title": "Records",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E8ECE9",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
