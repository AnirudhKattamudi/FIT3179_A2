
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Nature Photography Records Are Rising",
    "subtitle": "Summed ALA photographic observation counts, Australia, 2023–2025",
    "anchor": "start",
    "font": "DM Sans",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#174f3b",
    "subtitleFont": "DM Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#53675b",
    "offset": 20
  },
  "width": 650,
  "height": 330,
  "data": {
    "url": "data/02_ala_annual_counts.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "population_count": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "population_count",
          "as": "records"
        }
      ],
      "groupby": ["year"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#24765B",
        "strokeWidth": 4,
        "point": {
          "filled": true,
          "color": "#24765B",
          "size": 120
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "records",
          "type": "quantitative",
          "title": "Summed photographic records",
          "scale": {
            "zero": true
          },
          "axis": {
            "format": "~s"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "records",
            "type": "quantitative",
            "title": "Records",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -18,
        "font": "DM Sans",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#24765B"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "records",
          "type": "quantitative"
        },
        "text": {
          "field": "records",
          "type": "quantitative",
          "format": ".2s"
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E8ECE9",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    }
  }
}
