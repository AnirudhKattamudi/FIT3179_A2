
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Are Australians Photographing Nature?",
    "subtitle": "Photographic observation records by state and territory",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12
  },
  "width": 650,
  "height": 460,
  "data": {
    "url": "data/04_ala_state_year_counts.csv"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [2023, 2024, 2025],
        "name": "Select year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "toNumber(datum.year) == selectedYear"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/australian_states.geojson",
          "format": {
            "type": "json",
            "property": "features"
          }
        },
        "key": "properties.STATE_NAME",
        "fields": ["geometry"]
      }
    },
    {
      "filter": "isValid(datum.geometry)"
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [134, -25],
    "scale": 650
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },
  "encoding": {
    "shape": {
      "field": "geometry",
      "type": "geojson"
    },
    "color": {
      "field": "population_count",
      "type": "quantitative",
      "title": "Observation records",
      "scale": {
        "scheme": "greens",
        "domainMin": 0
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State / Territory"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "population_count",
        "type": "quantitative",
        "title": "Observation records",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}
