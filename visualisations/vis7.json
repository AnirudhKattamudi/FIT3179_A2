
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 410,
  "padding": {
    "left": 5,
    "right": 10,
    "top": 10,
    "bottom": 40
  },
  "data": {
    "url": "data/02_ala_annual_counts.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "population_count": "number"
      }
    }
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2025,
      "bind": {
        "input": "select",
        "options": [2023, 2024, 2025],
        "name": "Select year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == selectedYear && isValid(datum.state) && isValid(datum.category) && isValid(datum.population_count)"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "population_count",
          "as": "records"
        }
      ],
      "groupby": ["state", "category"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "records",
          "as": "state_total"
        }
      ],
      "groupby": ["state"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "records",
          "as": "national_total"
        }
      ]
    },
    {
      "calculate": "datum.records / datum.state_total",
      "as": "category_share"
    },
    {
      "calculate": "datum.state_total / datum.national_total",
      "as": "state_share"
    },
    {
      "stack": "records",
      "groupby": ["state"],
      "sort": [
        {
          "field": "category",
          "order": "ascending"
        }
      ],
      "offset": "normalize",
      "as": ["y0", "y1"]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "category_row"
        }
      ],
      "groupby": ["state"],
      "sort": [
        {
          "field": "category",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.category_row == 1 ? datum.state_total : 0",
      "as": "state_once"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "state_once",
          "as": "cumulative_total"
        }
      ],
      "sort": [
        {
          "field": "state",
          "order": "ascending"
        },
        {
          "field": "category_row",
          "order": "ascending"
        }
      ],
      "frame": [null, 0]
    },
    {
      "calculate": "datum.cumulative_total / datum.national_total",
      "as": "x1"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "x1",
          "as": "state_x1"
        }
      ],
      "groupby": ["state"]
    },
    {
      "calculate": "datum.state_x1 - datum.state_share",
      "as": "state_x0"
    },
    {
      "calculate": "(datum.state_x0 + datum.state_x1) / 2",
      "as": "state_mid"
    },
    {
      "calculate": "datum.state == 'Australian Capital Territory' ? 'ACT' : datum.state == 'New South Wales' ? 'NSW' : datum.state == 'Northern Territory' ? 'NT' : datum.state == 'Queensland' ? 'QLD' : datum.state == 'South Australia' ? 'SA' : datum.state == 'Tasmania' ? 'TAS' : datum.state == 'Victoria' ? 'VIC' : datum.state == 'Western Australia' ? 'WA' : datum.state",
      "as": "state_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "state_x0",
          "type": "quantitative",
          "title": "Share of Australian photographic records",
          "scale": {
            "domain": [0, 1]
          },
          "axis": {
            "format": ".0%",
            "grid": false
          }
        },
        "x2": {
          "field": "state_x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "title": "Nature-group share within state",
          "scale": {
            "domain": [0, 1]
          },
          "axis": {
            "format": ".0%"
          }
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Nature group",
          "scale": {
            "scheme": "tableau10"
          },
          "legend": {
            "orient": "bottom",
            "columns": 4
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "category",
            "type": "nominal",
            "title": "Nature group"
          },
          {
            "field": "records",
            "type": "quantitative",
            "title": "Observation records",
            "format": ","
          },
          {
            "field": "category_share",
            "type": "quantitative",
            "title": "Share within state",
            "format": ".1%"
          },
          {
            "field": "state_share",
            "type": "quantitative",
            "title": "Share of national records",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.category_row == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -8,
        "font": "DM Sans",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#263B32"
      },
      "encoding": {
        "x": {
          "field": "state_mid",
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "y": {
          "datum": 1,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          }
        },
        "text": {
          "field": "state_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "background": "white",
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#E8ECE9"
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
